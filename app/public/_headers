# https://developers.cloudflare.com/workers/static-assets/headers
# Static files are served before the worker, so next.config headers() do not reach them.
# Framing: only by pages of this site (the hub /guide/ shows the prototypes /p/<dir>/ in a same-origin iframe).
# The Worker's answers get the same from next.config.ts headers() and src/worker/page-front.ts.
/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
