# Server configuration. src/server/env.ts reads these from process.env. Placeholders only: no real address, key or
# password ever goes into the repository (tests/unit/test-addresses.test.ts rejects real addresses).
#
# Production (Vercel): these are the project's Environment Variables, entered in the Vercel dashboard or with
# `vercel env add`, never in a file of the repository. The six required ones below must be set: without one every
# request answers 500 and the error names the variable (never its value). The optional ones at the end switch features on.
#
# Local `next dev`: nothing has to be set. Without a value, the database is the local one below (the docker Postgres on
# port 5432), SITE_URL and MAIL_FROM are the public values below, and ADMIN_EMAILS, ADMIN_NAMES and MARIA_EMAIL are
# empty: nobody can sign in, nothing is sent. To sign in with your own address, copy this file to .env.local (git-ignored;
# Next.js reads it) and change the values.
#
# The e2e tests (playwright.config.ts) hand DATABASE_URL, ADMIN_EMAILS, ADMIN_NAMES and MARIA_EMAIL of THIS file to the dev
# server they start (they win over a .env.local) and sign in as the first ADMIN_EMAILS address. They refuse to run when a
# database setting anywhere points at a machine other than this one (tests/e2e/local-db.ts), and when RESEND_API_KEY or
# TELEGRAM_BOT_TOKEN is set. The database tools (npm run db:migrate, db:seed) take DATABASE_URL from the shell.

# --- required in production ---

# the Postgres connection URL: the local database here; in production Railway's TCP proxy URL (a password inside), with
# ?sslmode=require at the end: it is reached over the internet, and postgres.js encrypts only when the URL says so
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mslab
# the site's own address: links that leave the site (e-mails, link previews)
SITE_URL=https://mslab.diipsolutions.eu
# the sign-in allow-list, comma-separated
ADMIN_EMAILS=admin@example.test,second.admin@example.test
# the greeting name of each admin: <address>=<name>, comma-separated
ADMIN_NAMES=admin@example.test=Dim,second.admin@example.test=Maria
# where form notifications go (never sent locally without RESEND_API_KEY)
MARIA_EMAIL=maria@example.test
# the From header of outgoing mail
MAIL_FROM=MS LAB <info@send.diipsolutions.eu>

# --- optional: leave them out locally ---

# e-mail through Resend; without it nothing is sent and a console note says so
# RESEND_API_KEY=
# Telegram pings to Maria; TELEGRAM_CHAT_ID overrides the chat id kept in the database (kv_entries key tg:chat)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# the access key of the review comment list (/guide/tagasiside/); `next dev` accepts a local key when it is not set
# ADMIN_KEY=
# the image bucket on Cloudflare R2, through its S3 API (an R2 API token's access key; all four, or none). With none set,
# `next dev` keeps uploaded images in the folder app/.media-local (git-ignored); in production no R2 means no uploads
# and /media answers 404
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
